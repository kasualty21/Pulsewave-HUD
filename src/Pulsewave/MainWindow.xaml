<Window x:Class="Pulsewave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulsewave System Monitor" Icon="pack://application:,,,/Assets/Pulsewave-logo.ico" Width="1920" Height="480"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ShowActivated="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="BaseText" Color="#FAFCFF"/>
    <SolidColorBrush x:Key="DimText" Color="#D1E0ED"/>
    <SolidColorBrush x:Key="MutedText" Color="#A8BFD0"/>
    <SolidColorBrush x:Key="Mint" Color="#76F5D9"/>
    <SolidColorBrush x:Key="Blue" Color="#9EC6FF"/>
    <SolidColorBrush x:Key="Lavender" Color="#D8B7FF"/>
    <SolidColorBrush x:Key="Amber" Color="#FFBF6E"/>
    <SolidColorBrush x:Key="Danger" Color="#FF7777"/>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Background" Value="#EB11212B"/>
      <Setter Property="BorderBrush" Value="#9476F5D9"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DimText}"/>
      <Setter Property="FontSize" Value="25"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="BigNumber" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BaseText}"/>
      <Setter Property="FontSize" Value="106"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DimText}"/>
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MediumNumber" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BaseText}"/>
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
  </Window.Resources>

  <!-- The Classic layout is drawn in 1920 x 480 units. The Viewbox keeps the overlay
       monitor-independent without DPI assumptions: it fills a bar-shaped display and keeps its
       shape (letterboxed) on other displays. Themes carry their own size. -->
  <Grid x:Name="Root">
  <Viewbox x:Name="ClassicView" Stretch="Fill" StretchDirection="Both">
    <Grid Width="1920" Height="480" Background="Transparent">
      <Grid Margin="16,10,16,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="408"/>
        </Grid.RowDefinitions>

        <!-- Compact, high-contrast header: only information that needs to be seen at a glance. -->
        <Border x:Name="HeaderPanel" Grid.Row="0" Background="#EB11212B" CornerRadius="12" BorderBrush="#9476F5D9" BorderThickness="1"/>
        <Grid Grid.Row="0" Margin="14,0,14,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" Background="#E2203944" CornerRadius="10" Margin="0,0,13,0">
              <Viewbox Margin="7"><Canvas Width="20" Height="20">
                <Polyline Points="0,12 4,12 6,4 9,18 12,7 14,12 20,12" Stroke="#76F5D9" StrokeThickness="2.3" StrokeLineJoin="Round"/>
              </Canvas></Viewbox>
            </Border>
            <TextBlock Foreground="{StaticResource BaseText}" FontSize="29" FontWeight="Bold" VerticalAlignment="Center">PULSEWAVE</TextBlock>
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="HeaderStatus" Foreground="{StaticResource Mint}" FontSize="23" FontWeight="Bold" VerticalAlignment="Center">INITIALIZING</TextBlock>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="496"/>
          </Grid.ColumnDefinitions>

          <!-- TIME: large clock plus deliberately readable date and uptime. -->
          <Border x:Name="TimePanel" Grid.Column="0" Style="{StaticResource Panel}">
            <Grid Margin="22,21,22,19">
              <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="178"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource Heading}">LOCAL TIME</TextBlock>
              <!-- Clock keeps its size; tighter line heights lift it to make room for now playing. -->
              <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="ClockTime" Text="--:--" Foreground="{StaticResource BaseText}" FontFamily="Segoe UI" FontSize="110" FontWeight="SemiBold" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="118"/>
                <TextBlock x:Name="ClockDate" Text="LOADING DATE" Foreground="{StaticResource DimText}" FontSize="27" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,0" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="31"/>
              </StackPanel>
              <Border Grid.Row="2" BorderBrush="#9D506476" BorderThickness="0,1,0,0"/>
              <!-- Shown only when now playing is turned off in the tray. -->
              <StackPanel Grid.Row="3" x:Name="UptimeBlock" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="SYSTEM UPTIME" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="UptimeLabel" Text="--" Foreground="{StaticResource BaseText}" FontSize="33" FontFamily="Consolas" FontWeight="Bold" Margin="0,6,0,0"/>
              </StackPanel>
              <Grid Grid.Row="3" x:Name="NowPlayingBlock" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="NowPlayingArt" Width="96" Height="96" CornerRadius="12" Background="#A522303F" VerticalAlignment="Center">
                  <TextBlock x:Name="NowPlayingArtPlaceholder" Text="♪" Foreground="{StaticResource MutedText}" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock x:Name="NowPlayingStatus" Text="NOW PLAYING" Foreground="{StaticResource DimText}" FontSize="18" FontWeight="Bold"/>
                  <TextBlock x:Name="NowPlayingTitle" Text="Nothing playing" Foreground="{StaticResource DimText}" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="29" MaxHeight="58"/>
                  <TextBlock x:Name="NowPlayingArtist" Text="" Foreground="{StaticResource DimText}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
              <!-- Seconds remain in the view model but are intentionally hidden as nonessential. -->
              <TextBlock x:Name="ClockSeconds" Visibility="Collapsed"/>
            </Grid>
          </Border>

          <!-- CPU: largest figures are usage and temperature. -->
          <Border x:Name="CpuPanel" Grid.Column="2" Style="{StaticResource Panel}">
            <Grid Margin="22,21,22,19">
              <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="122"/>
                <RowDefinition Height="72"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Foreground="{StaticResource Mint}">CPU</TextBlock>
              <TextBlock Grid.Row="1" x:Name="CpuName" Text="CPU" Foreground="{StaticResource DimText}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="CpuLoad" Text="--" Style="{StaticResource BigNumber}"/>
                  <TextBlock Text="%" Foreground="{StaticResource Mint}" FontSize="47" FontWeight="Bold" Margin="4,0,0,6" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="TEMP" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="CpuTemp" Text="--°C" Foreground="{StaticResource Mint}" FontSize="49" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#A522303F" CornerRadius="10" Margin="0,1,6,1" Padding="10,4">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PWR" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CpuPower" Text="-- W" Style="{StaticResource MediumNumber}" FontSize="32" Margin="9,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#A522303F" CornerRadius="10" Margin="6,1,0,1" Padding="10,4">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FAN" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CpuFan" Text="-- RPM" Style="{StaticResource MediumNumber}" FontSize="28" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Grid.Row="5">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="CpuGraphCaption" Foreground="{StaticResource DimText}" FontSize="19" FontWeight="SemiBold">CPU LOAD · 90s</TextBlock>
                <Canvas Grid.Row="1" Width="447" Height="84" ClipToBounds="True">
                  <Line X1="0" Y1="20" X2="447" Y2="20" Stroke="#5260788D" StrokeThickness="1"/>
                  <Line X1="0" Y1="44" X2="447" Y2="44" Stroke="#5260788D" StrokeThickness="1"/>
                  <Line X1="0" Y1="68" X2="447" Y2="68" Stroke="#5260788D" StrokeThickness="1"/>
                  <Polyline x:Name="CpuGraph" Stroke="#76F5D9" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Grid>
            </Grid>
          </Border>

          <!-- GPU: FPS is promoted to a headline secondary metric. -->
          <Border x:Name="GpuPanel" Grid.Column="4" Style="{StaticResource Panel}">
            <Grid Margin="22,21,22,19">
              <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="122"/>
                <RowDefinition Height="72"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Foreground="{StaticResource Blue}">GPU</TextBlock>
              <TextBlock Grid.Row="1" x:Name="GpuName" Text="GPU" Foreground="{StaticResource DimText}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="GpuLoad" Text="--" Style="{StaticResource BigNumber}"/>
                  <TextBlock Text="%" Foreground="{StaticResource Blue}" FontSize="47" FontWeight="Bold" Margin="4,0,0,6" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="TEMP" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="GpuTemp" Text="--°C" Foreground="{StaticResource Blue}" FontSize="49" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#A522303F" CornerRadius="10" Margin="0,1,6,1" Padding="10,4">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PWR" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuPower" Text="-- W" Style="{StaticResource MediumNumber}" FontSize="32" Margin="9,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#A522303F" CornerRadius="10" Margin="6,1,0,1" Padding="10,4">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FPS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuFps" Text="--" Style="{StaticResource MediumNumber}" FontSize="49" Margin="9,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Grid.Row="5">
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="GpuGraphCaption" Foreground="{StaticResource DimText}" FontSize="19" FontWeight="SemiBold">GPU LOAD · 90s</TextBlock>
                <Canvas Grid.Row="1" Width="447" Height="84" ClipToBounds="True">
                  <Line X1="0" Y1="20" X2="447" Y2="20" Stroke="#5260788D" StrokeThickness="1"/>
                  <Line X1="0" Y1="44" X2="447" Y2="44" Stroke="#5260788D" StrokeThickness="1"/>
                  <Line X1="0" Y1="68" X2="447" Y2="68" Stroke="#5260788D" StrokeThickness="1"/>
                  <Polyline x:Name="GpuGraph" Stroke="#9EC6FF" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Grid>
            </Grid>
          </Border>

          <!-- SYSTEM: no tiny legends. The numbers are the content. -->
          <Border x:Name="SystemPanel" Grid.Column="6" Style="{StaticResource Panel}">
            <Grid Margin="22,21,22,19">
              <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="95"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="61"/>
                <RowDefinition Height="61"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Foreground="{StaticResource Lavender}">SYSTEM</TextBlock>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="RAM" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="MemoryLoad" Text="--%" Foreground="{StaticResource BaseText}" FontSize="78" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="2" Width="438" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                <Border Background="#6773869C" CornerRadius="6"/>
                <Border x:Name="MemoryFill" Width="0" Height="16" Background="{StaticResource Lavender}" CornerRadius="6" HorizontalAlignment="Left"/>
              </Grid>
              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="VRAM" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="GpuVram" Text="--" Style="{StaticResource MediumNumber}" FontSize="36" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="DOWNLOAD" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="DownRate" Text="-- MB/s" Foreground="{StaticResource Mint}" FontFamily="Consolas" FontSize="34" FontWeight="Bold" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="UPLOAD" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="UpRate" Text="-- MB/s" Foreground="{StaticResource Blue}" FontFamily="Consolas" FontSize="34" FontWeight="Bold" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="SENSORS" Foreground="{StaticResource DimText}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="SensorCount" Text="-- / 12 SENSORS" Foreground="{StaticResource BaseText}" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- No footer: space is allocated to the legible cards. Status is in the header. -->
      </Grid>
    </Grid>
  </Viewbox>
  <!-- A custom theme (Themes window) replaces the Classic layout above; it draws its own background. -->
  <Viewbox x:Name="ThemeHost" Stretch="Uniform" StretchDirection="Both" Visibility="Collapsed"/>
  <!-- The details page a tap on a readout opens (click-through off). -->
  <Viewbox x:Name="DetailHost" Stretch="Uniform" StretchDirection="Both" Visibility="Collapsed"/>
  <!-- Screen off by schedule: all black; a tap (click-through off) shows the HUD for a minute. -->
  <!-- Night dimming (schedule): a black veil over everything; taps pass through. -->
  <Border x:Name="DimCover" Background="Black" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"/>
  <Border x:Name="BlankCover" Background="Black" Visibility="Collapsed"/>
  </Grid>
</Window>
