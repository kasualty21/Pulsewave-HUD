<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LumenHUD</AssemblyName>
    <Version>0.14.0</Version>
    <Product>Lumen HUD</Product>
    <RootNamespace>Pulsewave</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LumenHUD-logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF's own touch layer is off: the HUD handles touch itself so it never moves the mouse cursor and is not counted twice (TouchInput.cs). Other windows get touch as ordinary clicks. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.DisableStylusAndTouchSupport" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\LumenHUD-logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in theme templates, read-only in the app (see Themes/BuiltInTemplates.cs). -->
    <EmbeddedResource Include="Templates\*.json" LogicalName="Pulsewave.Templates.%(Filename)%(Extension)" />
    <!-- Legacy templates (before Lumen): not in the gallery; Themes → Import legacy theme copies one into the user's themes. -->
    <EmbeddedResource Include="Templates\Legacy\*.json" LogicalName="Pulsewave.Legacy.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>





